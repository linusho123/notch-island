{
  "manifest_version": 3,
  "name": "notch-island companion",
  "description": "Tells notch-island what youtube.com and soundcloud.com tabs are playing, and carries its controls to them.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.soundcloud.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.soundcloud.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
